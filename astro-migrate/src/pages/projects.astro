---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projData } from '../data/portfolio';
---

<BaseLayout title="Projects — Mikhael Rakarenzo" description="All projects by Mikhael Rakarenzo" page="projects">
  <main class="page-main">

    <!-- Header -->
    <div class="page-header reveal-section">
      <div class="page-header-row">
        <a href="/" class="btn-back">← Back</a>
      </div>
      <div class="flex items-center gap-4 mb-3">
        <h1 class="section-title" style="font-size:clamp(2.5rem,5vw,4rem)" data-i18n="project.title">My Projects</h1>
        <span class="section-badge glass" id="proj-count-badge">{projData.length} Projects</span>
      </div>
      <p class="section-desc" data-i18n="project.desc">Recent enterprise projects and contributions.</p>
    </div>

    <!-- Grid -->
    <div class="content-grid reveal-section" id="project-grid-all"></div>

  </main>
</BaseLayout>

<script>
  import { projData } from '../data/portfolio';
  import { translations } from '../data/translations';
  import { getThemedImages, themedSrc } from '../scripts/theme-images';

  (window as any).__i18n = translations;
  const lang = () => (window as any).currentLang || localStorage.getItem('lang') || 'en';

  function render() {
    const l = lang();
    const grid = document.getElementById('project-grid-all');
    if (!grid) return;
    grid.innerHTML = '';
    projData.forEach(p => {
      const desc = l === 'id' && p.desc_id ? p.desc_id : p.desc;
      const category = l === 'id' && p.category_id ? p.category_id : p.category;
      const thumbs = getThemedImages(p);
      const src = themedSrc(thumbs);
      const card = document.createElement('div');
      card.className = 'portfolio-card glass card card-outline';
      card.innerHTML = `
        <div class="card-img-wrap">
          <img class="card-img js-theme-aware-thumb" alt="${p.title}" src="${src}"
               data-thumb-dark="${thumbs.dark}" data-thumb-light="${thumbs.light}"
               width="400" height="300" loading="lazy" decoding="async">
        </div>
        <div class="card-body">
          <div class="flex items-center justify-between gap-2" style="margin-bottom:0.5rem">
            <h3 class="card-title">${p.title}</h3>
            <span class="card-arrow">↗</span>
          </div>
          <p class="card-desc">${desc}</p>
          <div class="card-footer">
            <span class="truncate" style="max-width:65%">${category}</span>
            <span>${p.year}</span>
          </div>
        </div>
      `;
      card.addEventListener('click', () => (window as any).openProjectModal?.(p));
      grid.appendChild(card);
    });
    (window as any).applyI18n?.();
  }

  document.addEventListener('DOMContentLoaded', () => {
    render();
    document.addEventListener('languageChanged', render);
  });
</script>
