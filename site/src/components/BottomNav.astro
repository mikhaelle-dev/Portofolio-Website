---
const links = [
  { href: "/", id: "home", en: "Home", idText: "Beranda", icon: '<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/>' },
  { href: "/projects.html", id: "projects", en: "Projects", idText: "Proyek", icon: '<path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/>' },
  { href: "/certificates.html", id: "certificates", en: "Certificates", idText: "Sertifikat", icon: '<circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/>' },
  { href: "/about.html", id: "about", en: "About", idText: "Tentang", icon: '<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>' }
];
const { page } = Astro.props;
---
<nav class="bottom-nav" aria-label="Navigasi mobile">
  {links.map((link) => <a href={link.href} class:list={{ active: link.id === page }}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={link.icon}></svg><span data-id={link.idText} data-en={link.en}>{link.idText}</span></a>)}
</nav>
