---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BottomNav from "../components/BottomNav.astro";
import "../styles/global.css";
import SITE from "../data/site.js";

const { page, title, description = "Portofolio Mikhael Rakarenzo Mahendra di bidang administrasi jaringan, keamanan siber, dan perancangan jaringan." } = Astro.props;
---
<!doctype html>
<html lang="id" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | {SITE.name}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try { if (localStorage.getItem("dark_mode") === "false") document.documentElement.classList.remove("dark"); } catch (e) {}
    </script>
  </head>
  <body data-page={page}>
    <div class="bg-grid" aria-hidden="true"></div>
    <Header page={page} />
    <slot />
    <Footer />
    <BottomNav page={page} />
    <div class="overlay" id="detail-modal" role="dialog" aria-modal="true" aria-label="Detail" tabindex="-1"></div>
    <div class="overlay lightbox" id="image-lightbox" role="dialog" aria-modal="true" aria-label="Pratinjau gambar" tabindex="-1">
      <button class="lb-btn lb-close" data-lb="close" aria-label="Tutup">×</button>
      <button class="lb-btn lb-prev" data-lb="prev" aria-label="Sebelumnya">‹</button>
      <button class="lb-btn lb-next" data-lb="next" aria-label="Berikutnya">›</button>
      <span class="lb-count"></span>
    </div>
    <script>
      import "../scripts/site.js";
      import "../scripts/motion.js";
    </script>
  </body>
</html>
